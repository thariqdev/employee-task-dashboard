# Copy this file to .env and adjust values. Never commit .env.

NODE_ENV=development
PORT=4000

# SQLite file path, relative to server/prisma/schema.prisma
# For PostgreSQL: postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
DATABASE_URL="file:./dev.db"

# Use a long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string-of-at-least-32-chars"
JWT_EXPIRES_IN=8h

# Frontend origin allowed by CORS (comma-separated for several).
# In production: your Vercel address exactly, for example https://taskdesk.vercel.app (no slash at the end)
CLIENT_ORIGIN=http://localhost:5173

# Production only: how many proxies sit in front of the server (1 on Render). Leave 0 on your own computer.
TRUST_PROXY=0

# Production only: the first admin account, made on start if it does not exist yet (password: 12+ characters).
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=choose-a-long-password
# ADMIN_NAME=Your Name

# Demo admin account created by the seed script
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
